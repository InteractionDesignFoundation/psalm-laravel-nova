<?php

namespace Laravel\Nova\Fields;

/**
 * Nova types the visibility callbacks' 2nd param as the widest thing a resource can be
 * (`Model|Fluent|object|array`). A closure that narrows it to the resource's own model —
 * the idiomatic shape in every Nova app — is then rejected as contravariance-breaking
 * (`InvalidArgument`/`ArgumentTypeCoercion`), even though Nova always passes exactly that model.
 *
 * Redeclaring the param through a bounded method-level template lets Psalm infer `TResource`
 * from the closure instead of checking against a fixed union. Wrong request class, wrong return
 * type and wrong arity are still reported. What is lost is broader than cross-model confusion:
 * because the bound spans `Model|Fluent|array<array-key, mixed>|object`, any closure whose 2nd
 * param is consistent with that bound type-checks — not just a closure taking an unrelated model
 * (`fn(NovaRequest, Comment)` on a field that only ever appears on `Post`), but also one typed
 * `stdClass`, `DateTimeImmutable`, or an unrelated array shape, since `object` and
 * `array<array-key, mixed>` are broad enough to admit them. This is an accepted trade-off: Psalm
 * cannot know a field's owning resource, since the Field hierarchy is open and fields are shared
 * across resources.
 *
 * `showOnCreating()`/`hideWhenCreating()` take request-only callbacks and need no change.
 *
 * `canSee()` is narrowed to `NovaRequest` too (field resolution always goes through `NovaRequest`,
 * unlike `Tool`/`Dashboard`/`Filters\Filter`/`Menu\*`, which can receive a plain `Request`), but not
 * here: it's declared only on the `AuthorizedToSee` trait, which `FieldElement` merely inherits
 * (via `Element`), and a stub can't override a method the stubbed class only inherits — confirmed
 * empirically against real Nova. See `NovaFieldAuthorizationHandler` for the programmatic fix.
 */
abstract class FieldElement extends \Laravel\Nova\Element
{
    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function hideFromIndex(callable | bool $callback = true) {}

    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function hideFromDetail(callable | bool $callback = true) {}

    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function hideWhenUpdating(callable | bool $callback = true) {}

    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function showOnIndex(callable | bool $callback = true) {}

    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function showOnDetail(callable | bool $callback = true) {}

    /**
     * @template TResource of \Illuminate\Database\Eloquent\Model|\Laravel\Nova\Support\Fluent|array<array-key, mixed>|object
     * @param (callable(\Laravel\Nova\Http\Requests\NovaRequest, TResource):bool)|bool $callback
     * @return $this
     */
    public function showOnUpdating(callable | bool $callback = true) {}
}
