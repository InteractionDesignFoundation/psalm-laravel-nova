<?php

namespace Laravel\Nova\Actions;

use Laravel\Nova\Http\Requests\NovaRequest;

/** @see https://github.com/laravel/nova-issues/issues/6036 */
class Action implements \JsonSerializable
{
    use \Laravel\Nova\AuthorizedToSee;
    use \Illuminate\Support\Traits\Macroable;
    use \Laravel\Nova\Makeable;
    use \Laravel\Nova\Metable;
    use \Laravel\Nova\ProxiesCanSeeToGate;
    use \Illuminate\Support\Traits\Tappable;
    use \Laravel\Nova\WithComponent;

    /**
     * Get the fields displayed by the resource.
     *
     * @return list<\Laravel\Nova\Fields\Field|\Laravel\Nova\Panel>
     */
    public function fields(NovaRequest $request): array
    {
        return [];
    }

    /**
     * Nova types the models argument as a bare `Collection` (`Collection<array-key, mixed>` to Psalm),
     * so a callback typed against its own models is rejected. Nova passes an ActionModelCollection
     * filled from a database cursor (ActionRequest::chunks()), so its keys are always ints. `TKey`
     * lets a callback that accepts any key (`Collection<array-key, Post>`) keep matching, while
     * `int|TKey` still rejects a callback that only takes string keys. `TModel` is deliberately
     * unbounded: with a bound (`of Model`) a callback with no generic annotation would get
     * `Collection<array-key, Model>` instead of Nova's `Collection<array-key, mixed>`, and an invariant
     * Collection stub would then reject forwarding it to a `Collection<array-key, mixed>` parameter.
     *
     * @template TKey of array-key
     * @template TModel
     * @param \Stringable|string $name
     * @param \Closure(\Laravel\Nova\Fields\ActionFields, \Illuminate\Support\Collection<int|TKey, TModel>):mixed $handleUsing
     */
    public static function using($name, \Closure $handleUsing): static
    {
    }

    /**
     * @template TKey of array-key
     * @template TModel
     * @param \Closure(\Laravel\Nova\Fields\ActionFields, \Illuminate\Support\Collection<int|TKey, TModel>):mixed $callback
     * @return $this
     */
    public function handleUsing(\Closure $callback)
    {
    }

    /**
     * Return a dangerous message response from the action.
     *
     * @param string $name
     * @param string|null $message
     * @psalm-return (func_num_args() is 2
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function danger($name, string $message = null)
    {
    }

    /**
     * Return a delete response from the action.
     *
     * @return \Laravel\Nova\Actions\ActionResponse
     */
    public static function deleted()
    {
    }

    /**
     * Return a redirect response from the action.
     *
     * @param string $name
     * @param string|null $url
     * @psalm-return (func_num_args() is 2
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function redirect($name, $url = null)
    {
    }

    /**
     * Return a Inertia visit from the action.
     * @deprecated Use "visit"
     *
     * @param string $name
     * @param string $path
     * @param array<string, mixed> $options
     * @psalm-return (func_num_args() is 3
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function push($name, $path, $options = [])
    {
    }

    /**
     * Return a Inertia visit from the action.
     *
     * @param string $name
     * @param string|array<string, mixed> $path
     * @param array<string, mixed> $options
     * @psalm-return (func_num_args() is 3
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function visit($name, $path = [], $options = [])
    {
    }

    /**
     * Return an open in new tab response from the action.
     *
     * @param string $name
     * @param string|null $url
     * @psalm-return (func_num_args() is 2
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function openInNewTab($name, $url = null)
    {
    }

    /**
     * Return a download response from the action.
     * @deprecated Use "downloadURL"
     *
     * @param string $name
     * @param string $url
     * @return \Laravel\Nova\Actions\ActionResponse
     */
    public static function download($url, $name)
    {
    }

    /**
     * Return a download response from the action.
     *
     * @param string $name
     * @param string $url
     * @psalm-return (func_num_args() is 2
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function downloadURL($name, $url)
    {
    }

    /**
     * Return an action modal response from the action.
     *
     * @param string $name
     * @param string|array<string, mixed> $modal
     * @param array<string, mixed> $data
     * @psalm-return (func_num_args() is 3
     *  ? static
     *  : \Laravel\Nova\Actions\ActionResponse
     * )
     */
    public static function modal($name, $modal = [], $data = [])
    {
    }
}
