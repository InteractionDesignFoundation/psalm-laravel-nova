<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config ../../vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="scenarios"/>
    </projectFiles>

    <!-- Fake Nova reaches Psalm only via the composer classmap (autoload-dev), not <stubs>: config
         <stubs> are scanned before a plugin's own addStubFile() stubs and always "win" there, which
         previously masked a stub override that didn't actually work against normally-scanned code. -->

    <plugins>
        <pluginClass class="InteractionDesignFoundation\PsalmLaravelNova\Plugin"/>
    </plugins>
</psalm>
