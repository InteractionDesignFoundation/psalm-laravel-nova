<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config ../../vendor/vimeo/psalm/config.xsd"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="scenarios"/>
    </projectFiles>

    <!-- The fake Laravel/Nova declarations stand in for vendor code. They are registered as stub
         files (not project files) for two reasons: Psalm refuses stub files for class-likes inside
         <projectFiles>, and stub files declared in the config are scanned before the ones a plugin
         registers, so the plugin's stubs are the ones that win the override. -->
    <stubs>
        <file name="fake-nova/illuminate.php"/>
        <file name="fake-nova/nova.php"/>
        <file name="fake-nova/app.php"/>
    </stubs>

    <plugins>
        <pluginClass class="InteractionDesignFoundation\PsalmLaravelNova\Plugin"/>
    </plugins>
</psalm>
